<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <!-- NotifyIcon (system tray) requires the WinForms runtime. -->
    <UseWindowsForms>true</UseWindowsForms>
    <PlatformTarget>x64</PlatformTarget>
    <RootNamespace>MiPowerCenter</RootNamespace>
    <AssemblyName>MiPowerCenter</AssemblyName>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Folder deployment (self-contained). Single-file publish cannot host the Xiaomi C++/CLI
         wrapper, so PublishSingleFile is intentionally not used. -->
    <SelfContained>true</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <XiaomiDir Condition="Exists('C:\Program Files\MI\XiaomiPCManager\5.8.1.121')">C:\Program Files\MI\XiaomiPCManager\5.8.1.121</XiaomiDir>
    <XiaomiDir Condition="'$(XiaomiDir)' == '' And Exists('C:\Program Files\MI\XiaomiPCManager')">C:\Program Files\MI\XiaomiPCManager</XiaomiDir>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Assets\*.png" />
    <Resource Include="Assets\app.ico" />
  </ItemGroup>

  <!-- WinForms adds global usings for System.Drawing / System.Windows.Forms that clash with
       WPF types in the rest of the project; we only use NotifyIcon, so remove them. -->
  <ItemGroup>
    <Using Remove="System.Drawing" />
    <Using Remove="System.Windows.Forms" />
  </ItemGroup>

  <ItemGroup Condition="'$(XiaomiDir)' != ''">
    <!-- Bundle the Xiaomi native module DLLs (flat, root of the highest versioned install dir) so the
         app can host the wrapper natively. Managed framework facades are excluded. -->
    <XiaomiContent Include="$(XiaomiDir)\*.dll"
                   Exclude="$(XiaomiDir)\SvrCModuleClrWrapper.dll;
                            $(XiaomiDir)\Microsoft.*.dll;
                            $(XiaomiDir)\System.*.dll;
                            $(XiaomiDir)\mscorlib.dll;
                            $(XiaomiDir)\netstandard.dll;
                            $(XiaomiDir)\WindowsBase.dll;
                            $(XiaomiDir)\Presentation*.dll" />
    <Content Include="@(XiaomiContent)"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest">
      <TargetPath>%(Filename)%(Extension)</TargetPath>
    </Content>
    <!-- Self-contained host binaries so the app keeps working after XiaomiPCManager is
         uninstalled: the C++/CLI wrapper (loaded from the app dir via LoadFrom at runtime)
         and the native host processes the module starts (XiaomiPcHost / MiHygieneBroker). -->
    <XiaomiHostContent Include="$(XiaomiDir)\SvrCModuleClrWrapper.dll;
                                 $(XiaomiDir)\XiaomiPcHost.exe;
                                 $(XiaomiDir)\MiHygieneBroker.exe" />
    <Content Include="@(XiaomiHostContent)"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest">
      <TargetPath>%(Filename)%(Extension)</TargetPath>
    </Content>
  </ItemGroup>

  <!-- Self-contained Timi runtime (MiDeviceService, 含 MiScenarioRecognition 等) 与 EC 驱动：
       随应用发布，卸载管家后仍可注册服务并恢复性能模式。 -->
  <ItemGroup>
    <Content Include="Timi\**\*.*"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest" />
    <Content Include="drivers\**\*.*"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
</Project>